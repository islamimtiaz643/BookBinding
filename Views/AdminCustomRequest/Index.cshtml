@model List<BookBinding.Models.CustomJournalRequest>
@{
    ViewData["Title"] = "Custom Requests";
}

<div class="container py-4">
    <h2 class="mb-4">Custom Journal Requests</h2>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Leather</th>
                    <th>Paper</th>
                    <th>Binding</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@r.User?.FullName</td>
                        <td>@r.Leather?.Type - @r.Leather?.ColorName</td>
                        <td>@(r.Paper != null ? r.Paper.Name : $"Custom {r.CustomLengthMm}x{r.CustomWidthMm}mm")</td>
                        <td>@r.BindingStyle?.Name</td>
                        <td>
                            <span class="badge bg-@(r.Status == BookBinding.Models.Enums.RequestStatus.Submitted ? "warning text-dark" : r.Status == BookBinding.Models.Enums.RequestStatus.Completed ? "success" : r.Status == BookBinding.Models.Enums.RequestStatus.Cancelled ? "danger" : "info text-dark")">
                                @r.Status
                            </span>
                        </td>
                        <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-dark">Review</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No custom requests yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>