@model List<BookBinding.Models.User>
@{
    ViewData["Title"] = "Registered Users";
}

<div class="container py-4">
    <h2 class="mb-4">Registered Users</h2>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@(u.Phone ?? "-")</td>
                        <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No customers registered yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>