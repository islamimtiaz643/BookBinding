@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container py-4">
    <h2 class="section-title mb-4">My Dashboard</h2>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Custom Requests</h6>
                    <h2>@ViewBag.RequestCount</h2>
                    <a asp-controller="CustomJournal" asp-action="MyRequests" class="btn btn-sm btn-dark">View All</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pending Requests</h6>
                    <h2>@ViewBag.PendingRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Wishlist Items</h6>
                    <h2>@ViewBag.WishlistCount</h2>
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-sm btn-dark">View Wishlist</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="CustomJournal" asp-action="Create" class="btn btn-lg btn-dark">
            + Start a New Custom Journal
        </a>
    </div>
</div>