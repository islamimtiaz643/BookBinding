@model BookBinding.ViewModels.LeatherViewModel
@{
    ViewData["Title"] = "Add Leather";
}

<div class="container py-4">
    <h2 class="mb-4">Add Leather</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Type" class="form-label"></label>
                        <input asp-for="Type" class="form-control" placeholder="Full-grain / Suede / Faux" />
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ColorName" class="form-label"></label>
                        <input asp-for="ColorName" class="form-control" />
                        <span asp-validation-for="ColorName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ColorHex" class="form-label"></label>
                        <input asp-for="ColorHex" type="color" class="form-control form-control-color" value="#8B5E3C" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Texture" class="form-label"></label>
                        <input asp-for="Texture" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label"></label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-dark">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}