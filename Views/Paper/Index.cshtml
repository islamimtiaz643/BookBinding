@model List<BookBinding.Models.Paper>
@{
    ViewData["Title"] = "Manage Papers";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2>Manage Papers</h2>
        <a asp-action="Create" class="btn btn-dark">+ Add Paper</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Dimensions (mm)</th>
                    <th>GSM</th>
                    <th>Color</th>
                    <th>Design</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.LengthMm &times; @p.WidthMm</td>
                        <td>@p.Gsm</td>
                        <td>@p.Color</td>
                        <td>@p.DesignType</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this paper?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No papers added yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>